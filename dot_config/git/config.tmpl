[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[user]
	name = abb00717
	email = abb00717@gmail.com
[diff]
	tool = nvim
[difftool]
	prompt = false
[difftool "nvim"]
	cmd = nvim -d \"$LOCAL\" \"$REMOTE\"
[init]
	defaultBranch = main
[pull]
	rebase = false
{{- with lookPath "gh" }}
[credential "https://github.com"]
	helper =
	helper = !{{ . }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ . }} auth git-credential
{{- else }}
[url "git@github.com:"]
	insteadOf = https://github.com/
{{- end }}
# Per-machine settings such as safe.directory. Git skips it when missing.
[include]
	path = local
